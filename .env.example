# ====================================================================
# Sentinel Fusion Environment Configuration Example
# ====================================================================

# Database Connection (Defaults to local SQLite for zero-setup execution)
DATABASE_URL=sqlite:///./sentinel_fusion.db

# Authentication Security (Replace with high-entropy secret in production)
JWT_SECRET=sentinel_fusion_forensic_jwt_secret_key_2026_secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (demo, ollama)
# Default is 'demo', which operates deterministically without external models or API keys
AI_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Forensic Storage & Paths
STORAGE_PATH=./storage
OCR_PATH=tesseract
DEMO_MODE=true

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
